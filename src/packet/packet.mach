test "codec: subscribe multi-filter round-trip" {
    var a: allocator.Allocator;
    page.make(?a);
    var wb: buffer.WriteBuf = buffer.wbuf_make(?a);
    var p: Packet = zero(types.SUBSCRIBE);
    p.id = 10;
    var filters: [3]TopicFilter;
    filters[0] = TopicFilter{filter: "a/+/c", qos: 0};
    filters[1] = TopicFilter{filter: "x/#", qos: 1};
    filters[2] = TopicFilter{filter: "solo", qos: 2};
    p.filters = ?filters[0];
    p.filter_count = 3;
    if (is_err[usize, str](encode(?p, ?wb))) { ret 1; }
    var rb: buffer.ReadBuf = buffer.rbuf_make(wb.data, wb.len);
    val dr: Result[Packet, str] = decode(?rb, ?a);
    if (is_err[Packet, str](dr)) { ret 1; }
    val d: Packet = unwrap_ok[Packet, str](dr);
    if (d.kind != types.SUBSCRIBE) { ret 1; }
    if (d.id != 10) { ret 1; }
    if (d.filter_count != 3) { ret 1; }
    if (!str_equals(d.filters[0].filter, "a/+/c")) { ret 1; }
    if (d.filters[0].qos != 0) { ret 1; }
    if (!str_equals(d.filters[1].filter, "x/#")) { ret 1; }
    if (d.filters[1].qos != 1) { ret 1; }
    if (!str_equals(d.filters[2].filter, "solo")) { ret 1; }
    if (d.filters[2].qos != 2) { ret 1; }
    ret 0;
}

test "codec: suback multi-code round-trip" {
    var a: allocator.Allocator;
    page.make(?a);
    var wb: buffer.WriteBuf = buffer.wbuf_make(?a);
    var p: Packet = zero(types.SUBACK);
    p.id = 11;
    var codes: [3]u8 = [3]u8{0, 1, types.SUBACK_FAILURE};
    p.codes = ?codes[0];
    p.code_count = 3;
    if (is_err[usize, str](encode(?p, ?wb))) { ret 1; }
    var rb: buffer.ReadBuf = buffer.rbuf_make(wb.data, wb.len);
    val dr: Result[Packet, str] = decode(?rb, ?a);
    if (is_err[Packet, str](dr)) { ret 1; }
    val d: Packet = unwrap_ok[Packet, str](dr);
    if (d.kind != types.SUBACK) { ret 1; }
    if (d.id != 11) { ret 1; }
    if (d.code_count != 3) { ret 1; }
    if (d.codes[0] != 0) { ret 1; }
    if (d.codes[1] != 1) { ret 1; }
    if (d.codes[2] != types.SUBACK_FAILURE) { ret 1; }
    ret 0;
}

