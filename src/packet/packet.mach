fun ack_roundtrip(kind: u8) u8 {
    var a: allocator.Allocator;
    page.make(?a);
    var wb: buffer.WriteBuf = buffer.wbuf_make(?a);
    var p: Packet = zero(kind);
    p.id = 999;
    if (is_err[usize, str](encode(?p, ?wb))) { ret 1; }
    var rb: buffer.ReadBuf = buffer.rbuf_make(wb.data, wb.len);
    val dr: Result[Packet, str] = decode(?rb, ?a);
    if (is_err[Packet, str](dr)) { ret 1; }
    val d: Packet = unwrap_ok[Packet, str](dr);
    if (d.kind != kind) { ret 1; }
    if (d.id != 999) { ret 1; }
    ret 0;
}

