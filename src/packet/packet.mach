    p.retain = 1;
    p.id = 4242;
    p.publish.topic = "t";
    var pay: [1]u8 = [1]u8{'x'};
    p.publish.payload = field.Blob{data: ?pay[0], len: 1};
    if (is_err[usize, str](encode(?p, ?wb))) { ret 1; }
    var rb: buffer.ReadBuf = buffer.rbuf_make(wb.data, wb.len);
    val dr: Result[Packet, str] = decode(?rb, ?a);
    if (is_err[Packet, str](dr)) { ret 1; }
    val d: Packet = unwrap_ok[Packet, str](dr);
    if (d.qos != 1) { ret 1; }
    if (d.dup != 1) { ret 1; }
    if (d.retain != 1) { ret 1; }
    if (d.id != 4242) { ret 1; }
    if (!str_equals(d.publish.topic, "t")) { ret 1; }
    ret 0;
}

