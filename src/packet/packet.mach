    if (!str_equals(d.filters[0].filter, "a/b")) { ret 1; }
    if (!str_equals(d.filters[1].filter, "c/#")) { ret 1; }
    ret 0;
}

fun empty_roundtrip(kind: u8) u8 {
    var a: allocator.Allocator;
    page.make(?a);
    var wb: buffer.WriteBuf = buffer.wbuf_make(?a);
    var p: Packet = zero(kind);
    if (is_err[usize, str](encode(?p, ?wb))) { ret 1; }
    if (wb.len != 2) { ret 1; }
    var rb: buffer.ReadBuf = buffer.rbuf_make(wb.data, wb.len);
    val dr: Result[Packet, str] = decode(?rb, ?a);
    if (is_err[Packet, str](dr)) { ret 1; }
    if (unwrap_ok[Packet, str](dr).kind != kind) { ret 1; }
    ret 0;
}

test "codec: pingreq round-trip" { if (empty_roundtrip(types.PINGREQ) != 0) { ret 1; } ret 0; }
test "codec: pingresp round-trip" { if (empty_roundtrip(types.PINGRESP) != 0) { ret 1; } ret 0; }
test "codec: disconnect round-trip" { if (empty_roundtrip(types.DISCONNECT) != 0) { ret 1; } ret 0; }
